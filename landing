<script>
function setMode(m) {
  // Reset
  ['scanRing1','scanRing2'].forEach(id => document.getElementById(id).classList.remove('active'));
  document.getElementById('sweepWrap').classList.remove('active');
  document.getElementById('layerScan').classList.remove('active');
  document.querySelectorAll('.ingredient-tag').forEach(el => el.classList.remove('show'));
  document.querySelectorAll('.layer-band').forEach(el => el.classList.remove('lit'));
  document.getElementById('heroImg').classList.remove('zoomed');
  document.getElementById('explodePanel').classList.remove('active');
  [0,1,2,3,4].forEach(i => {
    const fl = document.getElementById('fl'+i);
    if (!fl) return;
    fl.classList.remove('pop');
    fl.style.transform = '';
  });
  ['mf0','mf1','mf2','mf3'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.width = '0%';
  });

  if (m === 'scan') {
    document.getElementById('heroImg').classList.add('zoomed');
    ['scanRing1','scanRing2'].forEach(id => document.getElementById(id).classList.add('active'));
    document.getElementById('sweepWrap').classList.add('active');
    document.getElementById('layerScan').classList.add('active');
    // Light up layer bands one by one
    [0,1,2,3,4].forEach(i => {
      setTimeout(() => {
        document.getElementById('lb'+i).classList.add('lit');
        // Show corresponding tag
        const tagId = ['it0','it1','it2','it3','it4'][i];
        const el = document.getElementById(tagId);
        if (el) el.classList.add('show');
      }, 600 + i * 500);
    });
    setTimeout(() => {
      const el = document.getElementById('itTotal');
      if (el) el.classList.add('show');
    }, 600 + 5 * 500);
  }

  if (m === 'exploded') {
    document.getElementById('explodePanel').classList.add('active');
    // Reset left info
    [0,1,2,3,4].forEach(i => {
      const fi = document.getElementById('fi'+i);
      const fc = document.getElementById('fc'+i);
      if (fi) { fi.classList.remove('show'); }
      if (fc) { fc.classList.remove('show'); }
    });
    const offsets = [0, 12, 26, 42, 60];
    [0,1,2,3,4].forEach(i => {
      setTimeout(() => {
        const fl = document.getElementById('fl'+i);
        if (!fl) return;
        fl.style.transform = `translateY(-${offsets[i]}px)`;
        fl.classList.add('pop');
        // show corresponding left info
        const fi = document.getElementById('fi'+i);
        const fc = document.getElementById('fc'+i);
        if (fi) fi.classList.add('show');
        if (fc) fc.classList.add('show');
      }, i * 110);
    });
    setTimeout(() => {
      [38, 100, 32, 26].forEach((w, i) => {
        const el = document.getElementById('mf'+i);
        if (el) el.style.width = w + '%';
      });
    }, 700);
  }
}

// Voice phone animation
const bubbleStates = [
  "I can see spinach, chickpeas, and tomatoes. What's underneath?",
  "Got it — brown rice at the base and tahini mixed in. Was the dressing on the side or mixed through?",
  "Mixed through — perfect. Let me confirm what I'm logging…"
];
let bubbleIdx = 0;
function cycleBubble() {
  const el = document.getElementById('vpBubble');
  const voiceArea = document.getElementById('vpVoice');
  const confirmArea = document.getElementById('vpConfirm');
  if (!el) return;
  if (bubbleIdx < bubbleStates.length - 1) {
    el.style.opacity = '0';
    setTimeout(() => { bubbleIdx++; el.textContent = bubbleStates[bubbleIdx]; el.style.opacity = '1'; }, 400);
    setTimeout(cycleBubble, 3800);
  } else {
    setTimeout(() => {
      voiceArea.style.opacity = '0';
      setTimeout(() => {
        voiceArea.style.display = 'none';
        confirmArea.style.display = 'block';
        confirmArea.style.opacity = '0';
        setTimeout(() => { confirmArea.style.opacity = '1'; confirmArea.style.transition = 'opacity .4s'; }, 20);
        setTimeout(() => {
          confirmArea.style.opacity = '0';
          setTimeout(() => {
            confirmArea.style.display = 'none';
            voiceArea.style.display = 'block';
            voiceArea.style.opacity = '1';
            bubbleIdx = 0;
            el.textContent = bubbleStates[0];
            setTimeout(cycleBubble, 3200);
          }, 500);
        }, 4500);
      }, 400);
    }, 1200);
  }
}
setTimeout(cycleBubble, 3200);

// Accuracy bars on scroll
let barDone = false;
new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting && !barDone) {
      barDone = true;
      setTimeout(() => { document.getElementById('barBad').style.width = '57%'; }, 200);
      setTimeout(() => { document.getElementById('barGood').style.width = '100%'; }, 500);
    }
  });
}, { threshold: 0.3 }).observe(document.getElementById('accuracy') || document.body);

// Scroll reveal
new IntersectionObserver((entries) => {
  entries.forEach((e, i) => {
    if (e.isIntersecting) setTimeout(() => e.target.classList.add('up'), i * 55);
  });
}, { threshold: 0.12 }).observe(document.body);
document.querySelectorAll('.reveal').forEach(el => {
  new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('up'); });
  }, { threshold: 0.12 }).observe(el);
});

// Auto-loop: bowl → scan → explode → repeat
function runLoop() {
  setMode('combined');
  setTimeout(() => setMode('scan'), 2000);
  setTimeout(() => setMode('exploded'), 9000);
  setTimeout(runLoop, 15000);
}
runLoop();
</script>
