<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NutriSnap</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ─────────────────────────────────────────────
   RESET & BASE
───────────────────────────────────────────── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
:root {
  --ink:    #0E0D0A;
  --paper:  #F2EDE4;
  --sage:   #3D5C35;
  --sage-l: #5A8050;
  --gold:   #C8922A;
  --rust:   #B84E2A;
  --blush:  #E8C4A0;
  --mist:   rgba(14,13,10,0.45);
  --hairline: rgba(14,13,10,0.1);
}
html { scroll-behavior:smooth; font-size:16px; }
body {
  background: var(--ink);
  color: var(--paper);
  font-family: 'Syne', sans-serif;
  font-weight: 400;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ─────────────────────────────────────────────
   NAV
───────────────────────────────────────────── */
nav {
  position: fixed; top:0; left:0; right:0; z-index:200;
  padding: 1.5rem 3rem;
  display: flex; align-items:center; justify-content:space-between;
  mix-blend-mode: normal;
}
nav::before {
  content:'';
  position:absolute;inset:0;
  background: linear-gradient(to bottom, rgba(14,13,10,0.7), transparent);
  pointer-events:none;
}
.nav-logo {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.5rem; font-weight: 300; letter-spacing: 0.15em;
  color: var(--paper); text-transform:uppercase;
  position:relative; z-index:1;
}
.nav-right { display:flex; gap:2.5rem; align-items:center; position:relative; z-index:1; }
.nav-right a {
  text-decoration:none; color:rgba(242,237,228,0.6);
  font-size: 0.72rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase;
  transition: color .2s;
}
.nav-right a:hover { color: var(--paper); }
.nav-pill {
  background: var(--paper) !important; color: var(--ink) !important;
  padding: 0.5rem 1.25rem; border-radius: 100px;
  font-size: 0.72rem !important; font-weight: 700 !important;
  transition: background .2s !important;
}
.nav-pill:hover { background: var(--blush) !important; }

/* ─────────────────────────────────────────────
   HERO
───────────────────────────────────────────── */
.hero {
  height: 100vh; min-height: 700px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  position: relative;
  overflow: hidden;
}

/* LEFT — dark bg with centered bowl */
.hero-image-col {
  position: relative;
  overflow: hidden;
  background: #0A0C07;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Subtle radial glow behind bowl */
.hero-image-col::before {
  content:'';
  position:absolute;
  width:420px; height:420px;
  border-radius:50%;
  background: radial-gradient(circle, rgba(61,92,53,0.25) 0%, transparent 70%);
  pointer-events:none; z-index:0;
}

/* The centered bowl — circular, prominent */
.bowl-stage {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bowl-circle-wrap {
  position: relative;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  overflow: hidden;
  box-shadow:
    0 0 0 1px rgba(200,146,42,0.1),
    0 0 0 12px rgba(10,12,7,0.8),
    0 0 0 13px rgba(200,146,42,0.08),
    0 32px 80px rgba(0,0,0,0.7);
  flex-shrink: 0;
}

.bowl-circle-wrap img {
  width:100%; height:100%;
  object-fit:cover; object-position:center;
  display:block;
  transition: transform 8s ease;
}
.bowl-circle-wrap img.zoomed { transform: scale(1.08); }

/* Scan ring around bowl */
.bowl-scan-ring {
  position:absolute;
  border-radius:50%;
  pointer-events:none;
  opacity:0;
  transition: opacity .5s;
}
.bowl-scan-ring.r1 {
  inset:-16px;
  border: 1.5px solid rgba(200,146,42,0.7);
  animation: spinBowl 7s linear infinite;
}
.bowl-scan-ring.r2 {
  inset:-30px;
  border: 0.5px dashed rgba(200,146,42,0.25);
  animation: spinBowl 14s linear infinite reverse;
}
.bowl-scan-ring.active { opacity:1; }
@keyframes spinBowl { to { transform: rotate(360deg); } }

/* Gold dot on ring */
.bowl-scan-ring.r1::after {
  content:'';
  position:absolute; top:-5px; left:50%; transform:translateX(-50%);
  width:8px; height:8px;
  background:var(--gold); border-radius:50%;
  box-shadow: 0 0 10px var(--gold), 0 0 20px rgba(200,146,42,0.4);
}

/* Sweep line clipped to bowl */
.bowl-sweep-wrap {
  position:absolute; inset:0;
  border-radius:50%; overflow:hidden;
  pointer-events:none; opacity:0; transition:opacity .4s; z-index:3;
}
.bowl-sweep-wrap.active { opacity:1; }
.bowl-sweep-line {
  position:absolute; left:0; right:0; height:2px;
  background: linear-gradient(90deg, transparent, rgba(200,146,42,0.9) 50%, transparent);
  box-shadow: 0 0 12px rgba(200,146,42,0.5);
  animation: bowlSweep 2s linear infinite;
}
@keyframes bowlSweep { 0%{top:0%} 100%{top:100%} }

/* Layer scan lines — horizontal bands that light up */
.bowl-layer-scan {
  position:absolute; inset:0;
  border-radius:50%; overflow:hidden;
  pointer-events:none; opacity:0; transition:opacity .5s; z-index:2;
}
.bowl-layer-scan.active { opacity:1; }
.layer-band {
  position:absolute; left:0; right:0;
  opacity:0; transition:opacity .5s;
}
.layer-band.lit { opacity:1; }

/* Ingredient tags — stacked right of bowl */
.bowl-tags {
  position:absolute;
  left: calc(100% + 18px);
  top:50%; transform:translateY(-50%);
  display:flex; flex-direction:column; gap:.45rem;
  pointer-events:none; z-index:10;
  width: 170px;
}
.ingredient-tag {
  display:flex; align-items:center; gap:8px;
  background: rgba(10,12,7,0.88);
  backdrop-filter: blur(14px);
  border: 0.5px solid rgba(200,146,42,0.25);
  border-radius: 5px; padding:.35rem .8rem;
  white-space:nowrap;
  opacity:0; transform:translateX(-8px);
  transition: opacity .4s, transform .4s;
}
.ingredient-tag.show { opacity:1; transform:none; }
.itag-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; }
.itag-text { display:flex; flex-direction:column; gap:1px; }
.itag-name { font-size:.64rem; font-weight:600; letter-spacing:.03em; color:var(--paper); }
.itag-cal { font-size:.57rem; color:rgba(200,146,42,0.85); }

/* Scan image overlay — darkens non-scanned area */
.bowl-scan-overlay {
  position:absolute; inset:0; border-radius:50%;
  pointer-events:none; z-index:1; opacity:0; transition:opacity .5s;
}
.bowl-scan-overlay.active { opacity:1; }

/* RIGHT — text */
.hero-text-col {
  display:flex; flex-direction:column;
  justify-content:center;
  padding: 8rem 4rem 6rem 5rem;
  position:relative;
  background: var(--ink);
}

/* Vertical rule between columns */
.hero-text-col::before {
  content:'';
  position:absolute; left:0; top:15%; bottom:15%;
  width:0.5px;
  background: linear-gradient(to bottom, transparent, rgba(242,237,228,0.12), transparent);
}

.hero-eyebrow {
  display:flex; align-items:center; gap:10px;
  margin-bottom: 2rem;
  animation: fadeUp .6s ease both;
}
.eyebrow-line { width:32px; height:0.5px; background:var(--gold); }
.eyebrow-text {
  font-size:.65rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase;
  color: var(--gold);
}

.hero-h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(3.2rem, 5vw, 5rem);
  font-weight: 300; line-height: 1.0; letter-spacing:-.01em;
  color: var(--paper);
  margin-bottom: 2rem;
  animation: fadeUp .6s .08s ease both;
}
.hero-h1 em { font-style:italic; color:var(--gold); font-weight:300; }
.hero-h1 strong { font-weight:600; }

.hero-body {
  font-size:.9rem; line-height:1.8; color:rgba(242,237,228,0.55);
  max-width: 340px; margin-bottom: 2.5rem;
  animation: fadeUp .6s .16s ease both;
}

/* Stats row */
.hero-stats {
  display:flex; gap:2rem; margin-bottom:2.5rem;
  padding-bottom: 2.5rem;
  border-bottom: 0.5px solid var(--hairline);
  animation: fadeUp .6s .22s ease both;
}
.stat-num {
  font-family:'Cormorant Garamond',serif;
  font-size:2rem; font-weight:300; color:var(--paper); line-height:1;
  display:block;
}
.stat-label { font-size:.6rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:rgba(242,237,228,0.4); margin-top:.25rem; display:block; }

.hero-cta {
  display:flex; gap:1rem; align-items:center;
  animation: fadeUp .6s .28s ease both;
}
.btn-main {
  background: var(--gold); color: var(--ink);
  padding: .8rem 2rem; border-radius:3px;
  font-family:'Syne',sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
  text-decoration:none; transition: background .2s, transform .15s;
  display:inline-flex; align-items:center; gap:8px;
}
.btn-main:hover { background:var(--blush); transform:translateY(-1px); }
.btn-text {
  font-size:.72rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase;
  color:rgba(242,237,228,0.4); text-decoration:none; transition:color .2s;
}
.btn-text:hover { color:var(--paper); }



/* ─────────────────────────────────────────────
   EXPLODE VIEW (replaces hero when active)
───────────────────────────────────────────── */
.explode-panel {
  position:absolute; inset:0; z-index:50;
  background: var(--ink);
  display:grid;
  grid-template-columns: 1fr auto 1fr;
  align-items:center;
  gap:0;
  opacity:0; pointer-events:none;
  transition: opacity .5s ease;
  padding: 0 4rem;
}
.explode-panel.active { opacity:1; pointer-events:all; }

/* Left — spacer for layer label info */
.explode-left-info {
  display:flex; flex-direction:column; gap:0;
  align-items:flex-end;
  padding-right:1.5rem;
}

/* Layer stack — center column */
.layer-stack {
  display:flex; flex-direction:column; align-items:stretch;
  width:280px; gap:0;
  position:relative;
}

.fl {
  position:relative;
  height:50px;
  display:flex; align-items:center;
  transition: transform .8s cubic-bezier(.34,1.4,.64,1), opacity .5s;
  cursor:default;
  margin-bottom:1px;
}

.fl-slab {
  flex:1; height:100%;
  border-radius:3px;
  display:flex; align-items:center; padding:0 1rem;
  position:relative; overflow:hidden;
}
.fl-slab::after {
  content:'';
  position:absolute;inset:0;
  background:linear-gradient(to bottom,rgba(255,255,255,0.12) 0%,transparent 50%,rgba(0,0,0,0.15) 100%);
}
.fl-slab-name {
  position:relative; z-index:1;
  font-size:.68rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
  color:rgba(255,255,255,0.9); text-shadow:0 1px 4px rgba(0,0,0,0.4);
}

/* Layer info — now lives in left column, not absolute */
.fl-info {
  display:flex; flex-direction:column; gap:2px;
  text-align:right;
  height:51px;
  justify-content:center;
  padding-right:.5rem;
  opacity:0; transform:translateX(8px);
  transition: opacity .5s, transform .5s;
}
.fl-info.show { opacity:1; transform:none; }
.fl-info-cal { font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:300; color:var(--gold); line-height:1; }
.fl-info-name { font-size:.58rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--paper); }
.fl-info-macro { font-size:.58rem; color:rgba(242,237,228,0.38); line-height:1.4; }

/* Connector line from info to slab */
.fl-connector {
  width:20px; height:0.5px;
  background:rgba(242,237,228,0.1);
  align-self:center;
  flex-shrink:0;
  opacity:0; transition:opacity .5s;
}
.fl-connector.show { opacity:1; }

/* Bowl CSS base */
.bowl-base-css {
  width:280px; height:20px; margin-top:1px;
  background:linear-gradient(to bottom,#C8C0B0,#A0988A);
  border-radius:0 0 140px 140px;
  box-shadow:0 8px 24px rgba(0,0,0,0.5);
}
.bowl-rim-css {
  width:100%; height:10px;
  background:linear-gradient(to bottom,#E0D8C8,#C0B8A8);
  border-radius:50%;
}

/* Right — calorie breakdown */
.explode-right {
  display:flex; flex-direction:column; gap:1.25rem;
  padding-left:2.5rem;
  border-left:0.5px solid var(--hairline);
}
.exp-title { font-family:'Cormorant Garamond',serif; font-size:2.5rem; font-weight:300; color:var(--paper); line-height:1; }
.exp-title span { font-style:italic; color:var(--gold); }
.exp-subtitle { font-size:.62rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:rgba(242,237,228,0.35); }
.macro-bars { display:flex; flex-direction:column; gap:.75rem; margin-top:.5rem; }
.macro-row { display:flex; flex-direction:column; gap:.35rem; }
.macro-label-row { display:flex; justify-content:space-between; align-items:center; }
.macro-name { font-size:.6rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:rgba(242,237,228,0.45); }
.macro-val { font-size:.6rem; font-weight:600; color:var(--paper); }
.macro-track { height:2px; background:rgba(242,237,228,0.08); border-radius:1px; overflow:hidden; }
.macro-fill { height:100%; border-radius:1px; transition:width 1.2s ease; width:0; }

.exp-vs {
  padding:.75rem 1rem;
  border:0.5px solid rgba(184,78,42,0.25);
  border-radius:4px;
  background:rgba(184,78,42,0.06);
}
.exp-vs-label { font-size:.58rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:rgba(184,78,42,0.7); margin-bottom:.35rem; }
.exp-vs-nums { display:flex; align-items:baseline; gap:.5rem; }
.exp-vs-bad { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:300; color:rgba(184,78,42,0.7); text-decoration:line-through; }
.exp-vs-good { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:600; color:var(--paper); }
.exp-vs-unit { font-size:.6rem; color:rgba(242,237,228,0.4); }

/* ─────────────────────────────────────────────
   MARQUEE STRIP
───────────────────────────────────────────── */
.marquee-strip {
  border-top:0.5px solid var(--hairline);
  border-bottom:0.5px solid var(--hairline);
  padding:.9rem 0; overflow:hidden;
  background: rgba(242,237,228,0.02);
}
.marquee-track {
  display:flex; gap:3rem; width:max-content;
  animation: marquee 20s linear infinite;
}
.marquee-track:hover { animation-play-state:paused; }
@keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
.marquee-item {
  display:flex; align-items:center; gap:.6rem; white-space:nowrap;
  font-size:.62rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
  color:rgba(242,237,228,0.3);
}
.marquee-item .dot { width:4px; height:4px; background:var(--gold); border-radius:50%; }

/* ─────────────────────────────────────────────
   ACCURACY SECTION
───────────────────────────────────────────── */
.acc-section {
  display:grid; grid-template-columns:1fr 1fr;
  min-height:80vh;
  border-top:0.5px solid var(--hairline);
}
.acc-left {
  padding:7rem 5rem 7rem 6rem;
  border-right:0.5px solid var(--hairline);
  display:flex; flex-direction:column; justify-content:center;
}
.section-eyebrow {
  display:flex; align-items:center; gap:10px; margin-bottom:2rem;
}
.section-line { width:24px; height:0.5px; background:var(--gold); }
.section-tag { font-size:.62rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--gold); }
.acc-h2 {
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(2.5rem,4vw,4rem); font-weight:300; line-height:1.1; letter-spacing:-.01em;
  color:var(--paper); margin-bottom:1.5rem;
}
.acc-h2 em { font-style:italic; color:var(--gold); }
.acc-body { font-size:.875rem; line-height:1.85; color:rgba(242,237,228,0.5); max-width:380px; margin-bottom:2.5rem; }

/* Visual comparison */
.compare-visual { display:flex; flex-direction:column; gap:.5rem; }
.cv-row { display:flex; align-items:center; gap:1rem; }
.cv-label { font-size:.6rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; width:80px; flex-shrink:0; }
.cv-label.bad { color:rgba(184,78,42,0.6); }
.cv-label.good { color:var(--gold); }
.cv-bar-wrap { flex:1; height:36px; border-radius:3px; overflow:hidden; position:relative; }
.cv-bar { height:100%; border-radius:3px; display:flex; align-items:center; padding:0 1rem; position:relative; transition:width 1.4s cubic-bezier(.16,1,.3,1); }
.cv-bar-bad { background:rgba(184,78,42,0.2); border:0.5px solid rgba(184,78,42,0.25); width:0%; }
.cv-bar-good { background:rgba(200,146,42,0.15); border:0.5px solid rgba(200,146,42,0.3); width:0%; }
.cv-bar-num { font-family:'Cormorant Garamond',serif; font-size:1.2rem; font-weight:300; color:var(--paper); }
.cv-bar-bad .cv-bar-num { color:rgba(184,78,42,0.7); }
.cv-note { font-size:.62rem; color:rgba(242,237,228,0.3); margin-top:.25rem; }

.acc-right {
  padding:7rem 6rem 7rem 5rem;
  display:flex; flex-direction:column; justify-content:center; gap:3rem;
}

/* How it works steps */
.step { display:flex; gap:1.5rem; align-items:flex-start; }
.step-num {
  font-family:'Cormorant Garamond',serif; font-size:3rem; font-weight:300; line-height:1;
  color:rgba(242,237,228,0.06); flex-shrink:0; width:48px; text-align:right;
}
.step-content {}
.step-title { font-size:.78rem; font-weight:700; letter-spacing:.06em; color:var(--paper); margin-bottom:.4rem; }
.step-body { font-size:.82rem; line-height:1.75; color:rgba(242,237,228,0.4); }
.step + .step { padding-top:2.5rem; border-top:0.5px solid var(--hairline); }

/* ─────────────────────────────────────────────
   VOICE SECTION
───────────────────────────────────────────── */
.voice-section {
  border-top:0.5px solid var(--hairline);
  background: rgba(242,237,228,0.015);
}
.voice-inner {
  display:grid; grid-template-columns:1fr 1fr;
  min-height:80vh; align-items:center;
  max-width:1400px; margin:0 auto;
  padding:0 6rem; gap:6rem;
}
.voice-left { padding:7rem 0; }
.voice-chips {
  display:flex; flex-wrap:wrap; gap:.5rem; margin-top:2rem;
}
.voice-chip {
  padding:.45rem 1rem;
  border:0.5px solid rgba(242,237,228,0.12);
  border-radius:100px;
  font-size:.68rem; font-weight:500; letter-spacing:.02em;
  color:rgba(242,237,228,0.45);
  font-style:italic;
}

/* Phone mockup */
.voice-right { display:flex; justify-content:center; align-items:center; padding:4rem 0; }
.voice-phone {
  width:280px;
  background:#141410;
  border-radius:32px;
  border:0.5px solid rgba(242,237,228,0.1);
  overflow:hidden;
  box-shadow:0 40px 80px rgba(0,0,0,0.6), 0 0 0 0.5px rgba(242,237,228,0.05);
}
.vp-top {
  display:flex; justify-content:space-between; align-items:center;
  padding:.75rem 1.2rem .5rem;
}
.vp-logo { font-family:'Cormorant Garamond',serif; font-size:.9rem; font-weight:300; letter-spacing:.1em; color:rgba(242,237,228,0.6); text-transform:uppercase; }
.vp-time { font-size:.7rem; color:rgba(242,237,228,0.35); }
.vp-photo-stub { height:160px; position:relative; overflow:hidden; }
.vp-detected {
  position:absolute; bottom:0; left:0; right:0;
  padding:.75rem 1rem;
}
.vp-det-label { font-size:.55rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--gold); margin-bottom:.35rem; }
.vp-det-items { display:flex; gap:.35rem; flex-wrap:wrap; }
.vp-item { font-size:.58rem; font-weight:600; color:rgba(242,237,228,0.7); background:rgba(242,237,228,0.08); border:0.5px solid rgba(242,237,228,0.12); padding:.18rem .5rem; border-radius:3px; }

.vp-voice-area { padding:1rem 1.2rem 1.25rem; }
.vp-ai-bubble {
  background:rgba(200,146,42,0.1); border:0.5px solid rgba(200,146,42,0.2);
  border-radius:10px 10px 10px 3px; padding:.65rem .85rem; margin-bottom:.875rem;
}
.vp-bubble-label { font-size:.52rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--gold); margin-bottom:.3rem; }
.vp-bubble-text { font-size:.7rem; color:rgba(242,237,228,0.8); line-height:1.55; }

.vp-mic-area { display:flex; flex-direction:column; align-items:center; gap:.6rem; }
.vp-waveform { display:flex; align-items:center; gap:3px; height:28px; }
.wave-bar {
  width:3px; background:var(--gold); border-radius:2px;
  animation:wavePulse 1s ease-in-out infinite;
  opacity:0.7;
}
@keyframes wavePulse {
  0%,100%{height:4px;opacity:0.4}
  50%{height:22px;opacity:0.9}
}
